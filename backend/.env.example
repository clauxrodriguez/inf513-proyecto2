APP_NAME="Sistema Legalizaciones UAGRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (>= 13). Crear la base vacía y ejecutar: php artisan migrate --seed
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_legalizaciones
DB_USERNAME=postgres
DB_PASSWORD=
# Esquema asignado al grupo en db.tecnoweb.org.bo
DB_SCHEMA=public

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="legalizaciones@uagrm.edu.bo"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Microservicio de firma digital (carpeta /firmador). La clave debe coincidir con firmador.api-key
FIRMADOR_URL=http://127.0.0.1:8081/api
FIRMADOR_API_KEY=clave-local-firmador-inf513
FIRMADOR_TIMEOUT=120

# Firma con Jacobitus: verificador de los PDF firmados (firmador | agetic)
FIRMA_VERIFICADOR=firmador
FIRMA_EXIGIR_CONFIANZA=false
FIRMA_MAX_PDF_KB=15360

# Stripe: pagos en línea al contado (llaves de prueba sk_test_ en desarrollo).
# STRIPE_TIPO_CAMBIO convierte el arancel en Bs a la moneda de cobro (1 si STRIPE_MONEDA=bob)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONEDA=bob
STRIPE_TIPO_CAMBIO=1

# Validador Web de firmas de AGETIC (API REST)
AGETIC_VALIDADOR_URL=
AGETIC_VALIDADOR_CAMPO=archivo
AGETIC_VALIDADOR_TIMEOUT=60

# URL pública del frontend: destino del QR de los certificados (CU6).
# En producción: https://<servidor>/inf513/grupo20sa/proyecto2
FRONTEND_URL=http://localhost:5173
