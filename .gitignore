# Repositorio del Sistema de Legalizaciones UAGRM (INF513)
#   backend/   API Laravel        (ver backend/.gitignore)
#   frontend/  SPA React + Vite   (ver frontend/.gitignore)
#   firmador/  microservicio Java (ver firmador/.gitignore)
#   docs/      documentación
# Las reglas sin "/" inicial aplican en todas las carpetas.

# ---------------------------------------------------------------
# Proyecto Laravel por defecto que quedó en la raíz (no forma parte
# del sistema; el backend real está en backend/)
# ---------------------------------------------------------------
/app/
/bootstrap/
/config/
/database/
/public/
/resources/
/routes/
/storage/
/tests/
/vendor/
/node_modules/
/artisan
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpunit.xml
/vite.config.js
/.npmrc
/AGENTS.md
/CLAUDE.md
/boost.json
/.mcp.json
/.claude/
/.env.example

# ---------------------------------------------------------------
# Variables de entorno: contienen contraseñas y llaves (Stripe, BD,
# firmador). Solo se versionan las plantillas .env.example
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Llaves privadas y certificados (AC de prueba, softokens, sellos)
# ---------------------------------------------------------------
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem

# ---------------------------------------------------------------
# Dependencias y artefactos de compilación
# ---------------------------------------------------------------
node_modules/
vendor/
target/
dist/

# ---------------------------------------------------------------
# Configuración local de herramientas y del sistema operativo
# ---------------------------------------------------------------
.claude/settings.local.json
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini
*.log
