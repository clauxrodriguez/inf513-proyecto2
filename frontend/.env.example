# URL de la API de Laravel (por defecto http://127.0.0.1:8000/api).
# Copiar a .env.local solo si el backend corre en otra dirección.
VITE_API_URL=http://127.0.0.1:8000/api

# Jacobitus Local (firma digital con token o softoken en la PC del firmante)
VITE_JACOBITUS_URL=https://localhost:9000

# Stripe: llave pública (pk_test_ en desarrollo) para tokenizar tarjetas con Stripe.js
VITE_STRIPE_KEY=
